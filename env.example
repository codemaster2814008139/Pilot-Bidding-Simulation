# Copy to `.env` in this folder and fill in ONLY on the machine that runs proxy_server.py
# Never commit `.env`.

# API keys — set at least one for the provider you use:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Which provider the proxy calls. If omitted, it is inferred when only one key is set.
LLM_PROVIDER=anthropic

# Exact model IDs for Messages / Chat APIs (omit to use built-in defaults):
# Default Anthropic model: Claude Sonnet 4.5
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Default OpenAI: gpt-4o
# OPENAI_MODEL=gpt-4o

# Optional: listening port for proxy_server.py
# PILOT_BIDDING_PROXY_PORT=8765
